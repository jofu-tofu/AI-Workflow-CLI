{
  "planReview": {
    "enabled": true,
    "reviewers": {
      "codex": {
        "enabled": true,
        "model": "o4-mini",
        "timeout": 120
      },
      "gemini": {
        "enabled": false,
        "model": "",
        "timeout": 120
      }
    },
    "display": {
      "maxIssues": 12,
      "maxMissingSections": 12,
      "maxQuestions": 12
    }
  },
  "agentReview": {
    "enabled": true,
    "timeout": 180,
    "warnThreshold": 0.01,
    "orchestrator": {
      "enabled": true,
      "model": "opus",
      "timeout": 60
    },
    "legacyMode": false,
    "mandatoryAgents": {
      "always": ["handoff-readiness", "clarity-auditor", "skeptic"],
      "medium+": ["documentation-philosophy"]
    },
    "fallbackByComplexity": {
      "simple": 0,
      "medium": 12,
      "high": 6
    },
    "reviewIterations": {
      "simple": 1,
      "medium": 1,
      "high": 2
    },
    "highIssueThreshold": 2,
    "earlyExitOnAllPass": true,
    "display": {
      "maxIssues": 12,
      "maxMissingSections": 12,
      "maxQuestions": 12
    }
  },
  "agentSelection": {
    "simple": { "min": 3, "max": 3 },
    "medium": { "min": 12, "max": 12 },
    "high": { "min": 6, "max": 6 },
    "fallbackCount": 3
  },
  "agentDefaults": {
    "model": "sonnet"
  },
  "complexityCategories": [
    "code", "infrastructure", "documentation",
    "life", "business", "design", "research"
  ],
  "sanitization": {
    "maxSessionIdLength": 32,
    "maxTitleLength": 50
  },
  "planContext": {
    "enabled": true,
    "offerClarifyingQuestions": true
  },
  "stuckDetection": {
    "enabled": true,
    "errorThreshold": 3,
    "fileEditThreshold": 4,
    "testFailureThreshold": 3,
    "cooldown": 10,
    "maxSuggestions": 3
  }
}
