{
  "models": {
    "providers": {
      "claude": {
        "enabled": true,
        "models": ["sonnet"]
      },
      "codex": {
        "enabled": true,
        "models": ["gpt-5.4"],
        "reasoningEffort": "low"
      }
    }
  },
  "planReview": {
    "enabled": true,
    "display": {
      "maxIssues": 12,
      "maxMissingSections": 12,
      "maxQuestions": 12
    }
  },
  "agentReview": {
    "enabled": true,
    "timeout": 180,
    "warnThreshold": 0.01,
    "maxIssuesPerAgent": 3,
    "orchestrator": {
      "enabled": true,
      "model": "opus",
      "timeout": 60
    },
    "preflight": {
      "enabled": true,
      "timeoutMs": 15000
    },
    "legacyMode": false,
    "mandatoryAgents": {
      "always": ["handoff-readiness", "clarity-auditor", "skeptic"]
    },
    "fallbackByComplexity": {
      "simple": 0,
      "medium": 2,
      "high": 4
    },
    "reviewIterations": {
      "simple": 1,
      "medium": 3,
      "high": 5
    },
    "highIssueThreshold": 2,
    "earlyExitOnAllPass": true,
    "display": {
      "maxIssues": 12,
      "maxMissingSections": 12,
      "maxQuestions": 12
    }
  },
  "agentSelection": {
    "simple": { "min": 3, "max": 3 },
    "medium": { "min": 5, "max": 5 },
    "high": { "min": 7, "max": 7 },
    "fallbackCount": 2
  },
  "agentDefaults": {
    "model": "sonnet"
  },
  "complexityCategories": [
    "code", "infrastructure", "documentation",
    "life", "business", "design", "research"
  ],
  "sanitization": {
    "maxSessionIdLength": 32,
    "maxTitleLength": 50
  },
  "planContext": {
    "enabled": true,
    "offerClarifyingQuestions": true
  },
  "stuckDetection": {
    "enabled": true,
    "errorThreshold": 3,
    "fileEditThreshold": 4,
    "testFailureThreshold": 3,
    "cooldown": 10,
    "maxSuggestions": 3
  },
  "rlm": {
    "hyde": {
      "enabled": false,
      "provider": "ollama",
      "ollamaModel": "qwen2.5:1.5b",
      "numResponses": 5,
      "maxTokens": 200,
      "timeoutMs": 10000,
      "fallbackToQuery": true,
      "fallbackToClaude": false
    }
  }
}
