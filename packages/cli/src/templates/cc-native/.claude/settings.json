{
  "statusLine": {
    "type": "command",
    "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/scripts/status_line.ts"
  },
  "fileSuggestion": {
    "type": "command",
    "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/file-suggestion.ts"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/user_prompt_submit.ts",
            "timeout": 10000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_cc-native/hooks/plan_questions_early.ts",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/context_monitor.ts",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/task_create_capture.ts",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/task_update_capture.ts",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/archive_plan.ts",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/lint_after_edit.ts",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_cc-native/hooks/mark_questions_asked.ts",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_cc-native/hooks/enhance_plan_post_write.ts",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "^Task$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_cc-native/hooks/enhance_plan_post_subagent.ts",
            "timeout": 10000,
            "blockOnFail": false
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/session_start.ts",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/session_end.ts",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/pre_compact.ts",
            "timeout": 5000
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_core/hooks-ts/archive_plan.ts",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^TaskCreate$",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Evaluate this TaskCreate call for atomicity. Tasks become ISC criteria checked during verification — vague criteria cannot be verified, so precision matters. A well-specified task includes: (1) Explicit file paths like 'src/lib/auth.py' instead of 'the file above' or 'as discussed', (2) Specific function or component names instead of pronouns like 'it' or 'the function', (3) Clear expected state or behavior that is binary-testable in 2 seconds, (4) Concrete scope — one concern per task, not compound goals. If all four criteria are met and an agent with zero conversation history could verify the task was completed, return ok:true. If any criterion is missing, return ok:false with a response like: 'Missing context: [list each gap — e.g., no file path specified for the auth module, expected behavior is vague: what does fix the bug mean specifically, compound task should be split into separate criteria]'. When returning ok:false, end your response with: 'Retry: Re-invoke TaskCreate with a revised subject and description that address the gaps above.' This directive ensures the calling agent corrects and retries rather than abandoning the task."
          }
        ]
      },
      {
        "matcher": "^Task$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_cc-native/hooks/validate_task_prompt.ts",
            "timeout": 20000
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.aiwcli/bin/resolve-run.ts .aiwcli/_cc-native/hooks/cc-native-plan-review.ts",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [],
    "deny": []
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
