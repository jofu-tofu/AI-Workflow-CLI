{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "env": {},
  "enabledPlugins": {},
  "fileSuggestion": {
    "type": "command",
    "command": "python .aiwcli/_shared/hooks/file-suggestion.py"
  },
  "methods": {
    "cc-native": {
      "ides": [
        "claude"
      ],
      "installedAt": "2026-01-29T01:59:02.558Z"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/session_start.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/session_end.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/pre_compact.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/user_prompt_submit.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Read|Bash|WebFetch|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/context_monitor.py",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/task_create_capture.py",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/task_update_capture.py",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/archive_plan.py",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_cc-native/hooks/suggest-fresh-perspective.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/archive_plan.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_shared/hooks/task_create_atomicity.py",
            "timeout": 15000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_cc-native/hooks/add_plan_context.py",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python .aiwcli/_cc-native/hooks/cc-native-plan-review.py",
            "timeout": 600000
          }
        ]
      }
    ]
  }
}
